# Copy this file to ".env" and edit the values below.

# What to search for on Google Maps. You can combine keyword + location here.
SEARCH_QUERY="dentists in Lahore"

# How many unique listings to try to collect (scraper stops early if it runs out of results)
MAX_RESULTS=50

# Run the browser visibly (false) or in the background (true). Keep false at first so you can watch it work.
HEADLESS=false

# Seconds to wait between visiting each business website when looking for an email.
# Keep this reasonably high (2-4s) to avoid hammering sites / getting blocked.
WEBSITE_VISIT_DELAY=2

# Output Excel file name
OUTPUT_FILE=leads.xlsx
